{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chroma scene card",
  "description": "What the image side sends for one photo. See README.md in this folder.",
  "type": "object",
  "required": [
    "version",
    "name",
    "place",
    "mood",
    "stops"
  ],
  "properties": {
    "version": {
      "enum": [
        1,
        2
      ]
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_]+$",
      "minLength": 1,
      "maxLength": 80
    },
    "place": {
      "type": "object",
      "required": [
        "label",
        "confidence"
      ],
      "properties": {
        "label": {
          "enum": [
            "green",
            "street",
            "transit",
            "club",
            "market",
            "waterfront",
            "square",
            "beach",
            "metro",
            "airport",
            "mountains"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "time_of_day": {
      "type": "string"
    },
    "mood": {
      "type": "object",
      "required": [
        "brightness",
        "warmth",
        "saturation",
        "contrast",
        "n_colours"
      ],
      "properties": {
        "brightness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "warmth": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "saturation": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "contrast": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "n_colours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      }
    },
    "stops": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        ],
        "minItems": 3,
        "maxItems": 3
      }
    },
    "indoor": {
      "type": "object",
      "required": [
        "value",
        "confidence"
      ],
      "properties": {
        "value": {
          "type": "boolean"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "time": {
      "type": "object",
      "required": [
        "label",
        "confidence"
      ],
      "properties": {
        "label": {
          "enum": [
            "day",
            "golden_hour",
            "night"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "season": {
      "type": "object",
      "required": [
        "label",
        "confidence"
      ],
      "properties": {
        "label": {
          "enum": [
            "spring",
            "summer",
            "autumn",
            "winter"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "paving": {
      "type": "object",
      "required": [
        "label",
        "confidence"
      ],
      "properties": {
        "label": {
          "enum": [
            "cobblestones",
            "asphalt",
            "tiles",
            "stone_slabs",
            "gravel",
            "sand",
            "wood",
            "indoor_floor"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "details": {
      "type": "object",
      "properties": {
        "crowd": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "nature": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "gradient": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$"
      }
    },
    "city": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "noise": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "traffic": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "nightlife": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "trees": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sea": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "listener": {
      "description": "The listener's music-taste type (MUSIC model, Rentfrow et al. 2011). Shifts the music inside the photo's genre. Added by the app's server, not the image model.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "mellow",
            "unpretentious",
            "sophisticated",
            "intense",
            "contemporary"
          ]
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "mellow",
                "unpretentious",
                "sophisticated",
                "intense",
                "contemporary"
              ]
            },
            "tempo": {
              "type": "number",
              "minimum": -30,
              "maximum": 30,
              "description": "bpm shift, e.g. -12"
            },
            "reverb": {
              "type": "number",
              "minimum": -0.5,
              "maximum": 0.5,
              "description": "added reverb, e.g. 0.15"
            },
            "drums": {
              "type": "number",
              "minimum": 0,
              "maximum": 2,
              "description": "drum loudness factor, e.g. 0.7"
            },
            "surprises": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2,
              "description": "surprise chords per piece"
            }
          }
        }
      ]
    }
  }
}
