{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chroma scene card",
  "description": "What the image side sends for one photo. See README.md in this folder.",
  "type": "object",
  "required": ["version", "name", "place", "mood", "stops"],
  "properties": {
    "version": { "const": 1 },
    "name": { "type": "string", "pattern": "^[A-Za-z0-9_]+$", "minLength": 1, "maxLength": 80 },
    "place": {
      "type": "object",
      "required": ["label", "confidence"],
      "properties": {
        "label": { "enum": ["green", "street", "transit", "club", "market", "waterfront", "square"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "time_of_day": { "type": "string" },
    "mood": {
      "type": "object",
      "required": ["brightness", "warmth", "saturation", "contrast", "n_colours"],
      "properties": {
        "brightness": { "type": "number", "minimum": 0, "maximum": 1 },
        "warmth": { "type": "number", "minimum": -1, "maximum": 1 },
        "saturation": { "type": "number", "minimum": 0, "maximum": 1 },
        "contrast": { "type": "number", "minimum": 0, "maximum": 1 },
        "n_colours": { "type": "integer", "minimum": 1, "maximum": 8 }
      }
    },
    "stops": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "array",
        "prefixItems": [
          { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          { "type": "number", "minimum": 0, "maximum": 1 },
          { "type": "number", "minimum": 0, "maximum": 1 }
        ],
        "minItems": 3,
        "maxItems": 3
      }
    }
  }
}
